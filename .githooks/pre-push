#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "push rejected: gitleaks is required" >&2
  exit 1
fi

zero_sha=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    log_opts="$local_sha"
  else
    log_opts="$remote_sha..$local_sha"
  fi

  if ! gitleaks git --redact --log-opts "$log_opts"; then
    echo "push rejected: outgoing history contains a potential secret" >&2
    status=1
  fi
done

exit "$status"
